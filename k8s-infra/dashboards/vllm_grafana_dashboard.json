  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Time To First Token (TTFT) P95 / P99 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vllm:time_to_first_token_seconds_bucket[1m])) by (le))",
          "legendFormat": "TTFT P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(vllm:time_to_first_token_seconds_bucket[1m])) by (le))",
          "legendFormat": "TTFT P99"
        }
      ]
    },
    {
      "title": "GPU KV-Cache Memory Occupancy %",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "vllm:gpu_cache_usage_perc * 100",
          "legendFormat": "KV Cache Usage %"
        }
      ]
    },
    {
      "title": "Iteration Throughput (Tokens / Sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(vllm:avg_prompt_throughput_toks_per_s[1m]))",
          "legendFormat": "Prompt Tokens/s"
        },
        {
          "expr": "sum(rate(vllm:avg_generation_throughput_toks_per_s[1m]))",
          "legendFormat": "Generation Tokens/s"
        }
      ]
    },
    {
      "title": "Request Preemption Count",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(vllm:num_preemptions_total)",
          "legendFormat": "Total Preemptions"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["vllm", "llm-serving", "aethercontrol"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "AetherControl: vLLM Production Observability",
  "version": 1
